# Copia este archivo como .env (en la raíz del repo) y rellena los valores.
# .env no se sube al repo.

# Equipo (forma parte de los topics MQTT: salud/<equipo>/...)
EQUIPO=eq1

# API REST
PORT=3000
MONGO_URL=mongodb://localhost:27017/smarthealth

# Broker MQTT: Mosquitto nativo (el usuario y la contraseña los define A en mosquitto/)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=api
MQTT_PASS=cambia-esto

# Claves de la API (cabecera x-api-key)
API_KEY_PASARELA=cambia-esto-pasarela
API_KEY_MEDICO=cambia-esto-medico

# Node-RED (simulador, pasarela y dashboard): usuario de Mosquitto.
# Node-RED los lee al arrancar (ver TUTORIAL_DEV.md).
NODERED_MQTT_USER=nodered
NODERED_MQTT_PASS=cambia-esto
