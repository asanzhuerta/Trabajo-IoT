    {
        "id": "b0d1ca0000000015",
        "type": "function",
        "z": "b0d1ca0000000001",
        "name": "Tarjetas del equipo",
        "func": "const vista = flow.get('vista') || [];\nconst perfiles = flow.get('perfiles') || {};\nconst alertas = flow.get('alertas') || [];\nconst ahora = Date.now();\nconst v = (s, a, b) => s && s[a] && s[a][b] ? s[a][b].value : null;\nconst tarjetas = Object.keys(perfiles).map(idj => {\n    const p = perfiles[idj];\n    const j = vista.find(x => x.jugadorId === idj) || {};\n    const sinSenal = !j.ts || j.estado === 'sin_senal' || ahora - Date.parse(j.ts) > 5000;\n    const suyas = alertas.filter(a => a.jugadorId === idj);\n    // El semáforo sale de las alertas activas (lo calcula la API); sin señal se pinta gris aparte\n    let color = suyas.some(a => a.severidad === 'critica') ? 'rojo' : suyas.length ? 'ambar' : (j.semaforo || 'verde');\n    return {\n        id: idj, dorsal: p.dorsal, posicion: p.posicion, readaptacion: !!p.enReadaptacion,\n        color, sinSenal,\n        fc: v(j.sensors, 'pulsemeter', 'pulse'),\n        pct: j.derivados ? j.derivados.pctFcMax : null,\n        temp: v(j.sensors, 'thermometer', 'temperature'),\n        vel: j.sensors && j.sensors.gps && j.sensors.gps.speed ? j.sensors.gps.speed.value : null,\n        alertas: suyas.map(a => a.codigo)\n    };\n});\nreturn { payload: { tarjetas, seleccionado: flow.get('seleccionado') || null } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 220,
