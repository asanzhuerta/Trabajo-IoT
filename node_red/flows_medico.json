        "name": "Texto de la pauta",
        "func": "const idj = msg.jugadorId;\nif (idj !== flow.get('seleccionado')) return null;\nconst p = msg.statusCode === 200 ? msg.payload : null;\nflow.set('pauta', p);\nconst lim = [];\nif (p) {\n    if (p.velMax != null) lim.push('velocidad ≤ ' + p.velMax + ' km/h');\n    if (p.cargaMax != null) lim.push('carga ≤ ' + p.cargaMax + ' m de alta intensidad');\n    if (p.asimetriaMax != null) lim.push('asimetría ≤ ' + p.asimetriaMax + ' pts');\n}\nconst texto = p\n    ? 'P' + idj.slice(1) + ': ' + lim.join(' · ') + ' — hasta el ' + new Date(p.hasta).toLocaleDateString('es-ES') + (p.notas ? ' (' + p.notas + ')' : '')\n    : 'P' + idj.slice(1) + ' no tiene ninguna pauta activa.';\nreturn { payload: texto };",
