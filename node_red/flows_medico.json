        "func": "const a = msg.payload || {};\nif (!a.id || !a.por) return null;\nconst api = env.get('API_URL') || 'http://localhost:3000';\nconst clave = env.get('API_KEY_MEDICO');\nif (!clave) { node.error('Falta API_KEY_MEDICO en el .env'); return null; }\nmsg.method = 'POST';\nmsg.url = api + '/api/alertas/' + encodeURIComponent(a.id) + '/confirmar';\nmsg.headers = { 'Content-Type': 'application/json', 'x-api-key': clave };\nmsg.payload = { por: a.por };\nif (a.nota) msg.payload.nota = a.nota;\nmsg.accion = 'Alerta confirmada';\nreturn msg;",
