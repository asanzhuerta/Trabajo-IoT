    {
        "id": "b0d1ca0000000027",
        "type": "function",
        "z": "b0d1ca0000000001",
        "name": "POST /api/jugadores/:id/pauta",
        "func": "const idj = flow.get('seleccionado');\nconst f = msg.payload || {};\nconst cuerpo = {};\nfor (const k of ['velMax', 'cargaMax', 'asimetriaMax']) {\n    if (f[k] === '' || f[k] == null) continue;\n    const n = Number(f[k]);\n    if (!Number.isFinite(n) || n < 0) return [{ payload: k + ' tiene que ser un número positivo' }, null];\n    cuerpo[k] = n;\n}\nif (!Object.keys(cuerpo).length) return [{ payload: 'Indica al menos un límite: velocidad, carga o asimetría' }, null];\nif (!idj) return [{ payload: 'Elige antes un jugador' }, null];\n// La fecha del formulario (AAAA-MM-DD) vale hasta el final de ese día\nconst hasta = new Date(String(f.hasta) + 'T23:59:59');\nif (Number.isNaN(hasta.getTime())) return [{ payload: 'La fecha no es válida' }, null];\ncuerpo.hasta = hasta.toISOString();\nif (f.notas) cuerpo.notas = String(f.notas).trim();\nconst api = env.get('API_URL') || 'http://localhost:3000';\nconst clave = env.get('API_KEY_MEDICO');\nif (!clave) { node.error('Falta API_KEY_MEDICO en el .env'); return null; }\nmsg.method = 'POST';\nmsg.url = api + '/api/jugadores/' + idj + '/pauta';\nmsg.headers = { 'Content-Type': 'application/json', 'x-api-key': clave };\nmsg.payload = cuerpo;\nmsg.accion = 'Pauta creada';\nreturn [null, msg];",
