        "name": "Seleccionar jugador",
        "func": "const idj = String(msg.payload || '');\nif (!/^p\\d{1,2}$/.test(idj)) return null;\nconst cambia = flow.get('seleccionado') !== idj;\nflow.set('seleccionado', idj);\nnode.status({fill:'blue',shape:'dot',text: idj.toUpperCase()});\n// 1 dropdown (si se eligió en una tarjeta) · 2 limpiar la gráfica · 3 pedir la pauta · 4 repintar tarjetas\nreturn [cambia ? { payload: idj } : null, cambia ? { payload: [] } : null, { jugadorId: idj }, { topic: 'equipo' }];",
