    {
        "id": "b0d1ca000000000f",
        "type": "function",
        "z": "b0d1ca0000000001",
        "name": "Guardar perfiles y opciones",
        "func": "if (msg.statusCode !== 200 || !Array.isArray(msg.payload)) { node.status({fill:'red',shape:'ring',text:'API sin responder'}); return null; }\nconst perfiles = {};\nfor (const j of msg.payload) perfiles[j.id] = j;\nflow.set('perfiles', perfiles);\nnode.status({fill:'green',shape:'dot',text: msg.payload.length + ' jugadores'});\nconst etiqueta = j => 'P' + j.id.slice(1) + ' · dorsal ' + j.dorsal + ' · ' + j.posicion + (j.enReadaptacion ? ' · readaptación' : '');\nconst opciones = msg.payload.map(j => ({ value: j.id, label: etiqueta(j) }));\n// La primera vez se selecciona p1 para que la ficha no salga vacía\n// Con las opciones va el valor actual, para que el desplegable no se quede en blanco al refrescarlas\nconst actual = flow.get('seleccionado');\nreturn [{ options: opciones, payload: actual || 'p1' }, actual ? null : { topic: 'inicio', payload: 'p1' }];",
