        "type": "function",
        "z": "b0d1ca0000000001",
        "name": "Indicadores del seleccionado",
        "func": "const j = msg.jugador;\nconst p = (flow.get('perfiles') || {})[j.jugadorId] || {};\nconst v = (a, b) => j.sensors && j.sensors[a] && j.sensors[a][b] ? j.sensors[a][b].value : null;\nconst fc = v('pulsemeter', 'pulse');\nconst temp = v('thermometer', 'temperature');\nconst pct = j.derivados ? j.derivados.pctFcMax : null;\nconst alertas = (flow.get('alertas') || []).filter(a => a.jugadorId === j.jugadorId);\nconst ficha = { payload: { id: j.jugadorId, dorsal: p.dorsal, posicion: p.posicion, fcMax: p.fcMax, semaforo: j.semaforo, estado: j.estado,\n    zonaFc: j.derivados ? j.derivados.zonaFc : null, zonaVel: j.derivados ? j.derivados.zonaVelocidad : null,\n    asimetria: j.derivados ? j.derivados.asimetria : null, alertas: alertas.map(a => ({ codigo: a.codigo, severidad: a.severidad })),\n    pauta: flow.get('pauta') || null } };\nreturn [ficha, pct != null ? { payload: Math.round(pct) } : null, temp != null ? { payload: Number(temp.toFixed(1)) } : null,\n    fc != null ? { topic: 'FC ' + j.jugadorId.toUpperCase(), payload: fc } : null];",
