    {
        "id": "b0d1ca0000000012",
        "type": "function",
        "z": "b0d1ca0000000001",
        "name": "Guardar y ordenar alertas",
        "func": "if (msg.statusCode !== 200 || !Array.isArray(msg.payload)) { node.status({fill:'red',shape:'ring',text:'API sin responder'}); return null; }\nconst peso = a => (a.severidad === 'critica' ? 0 : 1);\nconst lista = msg.payload.slice().sort((a, b) => peso(a) - peso(b) || Date.parse(b.ts) - Date.parse(a.ts));\nflow.set('alertas', lista);\nnode.status({fill: lista.some(a => a.severidad === 'critica') ? 'red' : lista.length ? 'yellow' : 'green', shape:'dot', text: lista.length + ' activas'});\nreturn { payload: lista };",
