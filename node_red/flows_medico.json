        "head": "",
        "format": "<template>\n  <div class=\"alertas\">\n    <div class=\"medico\">\n      <label>Médico que confirma\n        <input v-model=\"por\" placeholder=\"Nombre o iniciales\" @change=\"guardarPor\" />\n      </label>\n    </div>\n    <div v-if=\"!lista.length\" class=\"vacio\">No hay alertas activas.</div>\n    <div v-for=\"a in lista\" :key=\"a.id\" class=\"fila\" :class=\"a.severidad\">\n      <div class=\"txt\">\n        <b>P{{ a.jugadorId.slice(1) }} · {{ a.codigo }}</b>\n        <span class=\"hora\">{{ hora(a.ts) }}</span>\n        <div class=\"msg\">{{ a.mensaje }}</div>\n        <input v-model=\"notas[a.id]\" class=\"nota\" placeholder=\"Nota (opcional)\" />\n      </div>\n      <v-btn size=\"small\" :color=\"a.severidad === 'critica' ? '#c62828' : '#a35f00'\" :disabled=\"!por.trim() || enviando[a.id]\"\n             @click=\"confirmar(a)\">{{ enviando[a.id] ? 'Enviando…' : 'Confirmar' }}</v-btn>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data () { return { por: '', notas: {}, enviando: {} } },\n  computed: { lista () { return (this.msg && Array.isArray(this.msg.payload)) ? this.msg.payload : [] } },\n  watch: { lista () { this.enviando = {} } },\n  mounted () { try { this.por = localStorage.getItem('smarthealth-medico') || '' } catch (e) {} },\n  methods: {\n    guardarPor () { try { localStorage.setItem('smarthealth-medico', this.por.trim()) } catch (e) {} },\n    hora (ts) { return new Date(ts).toLocaleTimeString('es-ES') },\n    confirmar (a) {\n      this.enviando = { ...this.enviando, [a.id]: true }\n      this.send({ topic: 'confirmar', payload: { id: a.id, por: this.por.trim(), nota: (this.notas[a.id] || '').trim() } })\n    }\n  }\n}\n</script>\n<style scoped>\n.alertas { display: flex; flex-direction: column; gap: 8px; width: 100%; }\n.medico label { display: flex; flex-direction: column; font-size: 12px; color: #4f5f6b; gap: 4px; }\n.medico input, .nota { border: 1px solid #c9d3da; border-radius: 6px; padding: 6px 8px; font: inherit; background: #fff; }\n.vacio { color: #6b7a86; padding: 8px 0; }\n.fila { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; border-left: 6px solid #f0a020; background: #fff7e8; }\n.fila.critica { border-left-color: #e0413a; background: #fdecea; }\n.txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }\n.hora { font-size: 11px; color: #6b7a86; }\n.msg { font-size: 13px; }\n.nota { font-size: 12px; padding: 4px 6px; }\n</style>",
