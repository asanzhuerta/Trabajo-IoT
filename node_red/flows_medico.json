        "func": "// 1 aviso en el dashboard · 2 refrescar alertas · 3 refrescar pauta\nconst ok = msg.statusCode >= 200 && msg.statusCode < 300;\nconst error = msg.payload && msg.payload.error ? msg.payload.error : ('error ' + (msg.statusCode || 'de conexión'));\nnode.status({fill: ok ? 'green' : 'red', shape:'dot', text: (ok ? msg.accion : error).slice(0, 40)});\n// Sin las cabeceras: llevan la clave del médico\nconst aviso = { payload: ok ? msg.accion : 'No se pudo guardar: ' + error };\nreturn [aviso, { topic: 'refrescar' }, msg.accion === 'Pauta creada' ? { jugadorId: flow.get('seleccionado') } : null];",
