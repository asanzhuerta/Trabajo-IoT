        "format": "<template>\n  <div class=\"ficha\" v-if=\"f\">\n    <div class=\"linea\">\n      <span class=\"luz\" :class=\"f.estado === 'sin_senal' ? 'gris' : f.semaforo\"></span>\n      <b>P{{ f.id.slice(1) }} · dorsal {{ f.dorsal }} · {{ f.posicion }}</b>\n      <span class=\"zona\">FCmáx {{ f.fcMax }} lpm</span>\n    </div>\n    <div class=\"linea pequena\">Zona FC: {{ f.zonaFc ?? '—' }} · Zona velocidad: {{ f.zonaVel ?? '—' }} · Asimetría: {{ f.asimetria != null ? f.asimetria.toFixed(1) + ' pts' : '—' }}</div>\n    <div class=\"linea pequena\" v-if=\"f.alertas.length\">\n      <span v-for=\"a in f.alertas\" :key=\"a.codigo\" class=\"alerta\" :class=\"a.severidad\">{{ a.codigo }}</span>\n    </div>\n    <div class=\"linea pequena\" v-else>Sin alertas activas</div>\n  </div>\n  <div v-else class=\"pequena\">Elige un jugador en el desplegable o en su tarjeta.</div>\n</template>\n<script>\nexport default { computed: { f () { return this.msg && this.msg.payload && this.msg.payload.id ? this.msg.payload : null } } }\n</script>\n<style scoped>\n.ficha { display: flex; flex-direction: column; gap: 6px; width: 100%; }\n.linea { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.pequena { font-size: 12px; color: #4f5f6b; }\n.zona { margin-left: auto; font-size: 12px; color: #4f5f6b; }\n.luz { width: 14px; height: 14px; border-radius: 50%; display: inline-block; }\n.luz.verde { background: #22a56b; } .luz.ambar { background: #f0a020; } .luz.rojo { background: #e0413a; } .luz.gris { background: #8d99a3; }\n.alerta { border-radius: 8px; padding: 1px 8px; font-size: 11px; background: #fff3d6; color: #7a4d00; }\n.alerta.critica { background: #fdecea; color: #a1231d; }\n</style>",
