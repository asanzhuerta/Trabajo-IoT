                "b0d1ca0000000016"
            ]
        ]
    },
    {
        "id": "b0d1ca0000000016",
        "type": "ui-template",
        "name": "Semáforo del equipo",
        "order": 1,
        "width": 12,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"equipo\">\n    <div v-if=\"!tarjetas.length\" class=\"vacio\">Esperando a la API…</div>\n    <button v-for=\"t in tarjetas\" :key=\"t.id\" type=\"button\" class=\"tarjeta\"\n            :class=\"[t.sinSenal ? 'gris' : t.color, { sel: t.id === seleccionado }]\"\n            @click=\"send({ topic: 'seleccionar', payload: t.id })\"\n            :title=\"t.alertas.length ? t.alertas.join(', ') : 'Sin alertas activas'\">\n      <div class=\"cab\">\n        <span class=\"dorsal\">{{ t.dorsal }}</span>\n        <span class=\"pos\">{{ t.posicion }} · P{{ t.id.slice(1) }}</span>\n        <span v-if=\"t.readaptacion\" class=\"chip\">readapt.</span>\n      </div>\n      <div class=\"datos\" v-if=\"!t.sinSenal\">\n        <span><b>{{ t.fc ?? '—' }}</b> lpm<small v-if=\"t.pct != null\"> {{ Math.round(t.pct) }} %</small></span>\n        <span><b>{{ t.temp != null ? t.temp.toFixed(1) : '—' }}</b> °C</span>\n        <span><b>{{ t.vel != null ? t.vel.toFixed(1) : '—' }}</b> km/h</span>\n      </div>\n      <div class=\"datos\" v-else><span>Sin señal del wearable</span></div>\n      <div class=\"pie\">{{ t.alertas.length ? t.alertas.join(' · ') : 'Sin alertas' }}</div>\n    </button>\n  </div>\n</template>\n<script>\nexport default {\n  computed: {\n    tarjetas () { return (this.msg && this.msg.payload && this.msg.payload.tarjetas) || [] },\n    seleccionado () { return this.msg && this.msg.payload ? this.msg.payload.seleccionado : null }\n  }\n}\n</script>\n<style scoped>\n.equipo { display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 10px; width: 100%; }\n.vacio { color: #6b7a86; padding: 12px; }\n.tarjeta { text-align: left; border-radius: 10px; padding: 10px 12px; border: 2px solid transparent; border-left-width: 8px; background: #f6f8fa; cursor: pointer; font: inherit; color: #14232e; }\n.tarjeta.sel { outline: 3px solid #0f2a3a; outline-offset: 1px; }\n.tarjeta.verde { border-left-color: #22a56b; }\n.tarjeta.ambar { border-left-color: #f0a020; background: #fff7e8; }\n.tarjeta.rojo { border-left-color: #e0413a; background: #fdecea; }\n.tarjeta.gris { border-left-color: #8d99a3; background: #eef1f3; color: #66737d; }\n.cab { display: flex; align-items: center; gap: 8px; }\n.dorsal { font-size: 22px; font-weight: 700; min-width: 28px; }\n.pos { font-size: 12px; color: #4f5f6b; }\n.chip { margin-left: auto; font-size: 10px; background: #0f2a3a; color: #fff; border-radius: 8px; padding: 1px 6px; }\n.datos { display: flex; justify-content: space-between; gap: 6px; margin-top: 6px; font-size: 12px; }\n.datos b { font-size: 15px; }\n.datos small { color: #6b7a86; }\n.pie { margin-top: 6px; font-size: 11px; color: #4f5f6b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n</style>",
